PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
SMARTADS_TIMEZONE=Africa/Douala
# Use the computer's Wi-Fi IPv4 address so the Android TV can fetch videos.
SMARTADS_PUBLIC_URL=http://192.168.1.10:3000
# Leave blank when this database has exactly one billboard.
SMARTADS_PLAYBACK_BILLBOARD_ID=
# VLC Android 3.6+: copy the Remote Access URL and one-time code shown on TV.
VLC_REMOTE_URL=https://192.168.1.20:8443
VLC_REMOTE_OTP=replace-with-current-vlc-one-time-code
# Optional ESP32 relay endpoint; firmware is in BACKEND/esp32/SMARTADSRelay.ino.
ESP32_RELAY_URL=http://192.168.1.30/relay
ESP32_DEVICE_TOKEN=replace-with-the-same-random-token-as-esp32-firmware
ESP32_POWER_ON_DELAY_MS=5000
